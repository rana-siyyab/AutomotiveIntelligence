@using System.Text.Json
@model AutomotiveIntelligence.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

<div class="admin-dashboard">

    <div class="page-header">

        <div>
            <h1>Automotive Intelligence</h1>

            <p>
                Pakistan automotive market and industry intelligence
            </p>
        </div>

    </div>


    <!-- MARKET OVERVIEW -->

    <section class="dashboard-section">

        <div class="section-header">

            <div>
                <h2>Market Overview</h2>

                <span class="section-subtitle">
                    Current used-car market indicators
                </span>
            </div>

        </div>


        <div class="dashboard-grid">

    <div class="dashboard-card kpi-card">
        <div class="kpi-label">
            Market Records
        </div>

        <div class="kpi-value">
            @Model.MarketOverview.TotalMarketRecords.ToString("N0")
        </div>

        <div class="kpi-description">
            Used-car market observations
        </div>
    </div>

    <div class="dashboard-card kpi-card">
        <div class="kpi-label">
            Average Estimated Price
        </div>

        <div class="kpi-value">
            PKR @Model.MarketOverview.AverageEstimatedPrice.ToString("N0")
        </div>

        <div class="kpi-description">
            Average valuation estimate
        </div>
    </div>

    <div class="dashboard-card kpi-card">
        <div class="kpi-label">
            Latest Market Price
        </div>

        <div class="kpi-value">
            PKR @Model.MarketOverview.LatestAverageMarketPrice.ToString("N0")
        </div>

        <div class="kpi-description">
            Latest observed market average
        </div>
    </div>

    <div class="dashboard-card kpi-card">
        <div class="kpi-label">
            Total Valuations
        </div>

        <div class="kpi-value">
            @Model.MarketOverview.TotalValuations.ToString("N0")
        </div>

        <div class="kpi-description">
            Valuations generated by the platform
        </div>
    </div>

    <div class="dashboard-card kpi-card">
        <div class="kpi-label">
            Last Market Observation
        </div>

        <div class="kpi-value kpi-value-date">
            @(Model.MarketOverview.LastMarketObservationDate.HasValue
                ? Model.MarketOverview.LastMarketObservationDate.Value.ToString("dd MMM yyyy")
                : "No data")
        </div>

        <div class="kpi-description">
            Most recent market data observation
        </div>
    </div>

</div>

    </section>


    <!-- PRICE TREND -->

    <section class="dashboard-section">

        <div class="section-header">

            <div>
                <h2>Used-Car Price Trend</h2>

                <span class="section-subtitle">
                    Last 30 days
                </span>
            </div>

        </div>


        <div class="dashboard-card chart-card">

            <div id="priceTrendChart"
                 class="dashboard-chart">
            </div>

        </div>

    </section>


    <!-- POPULAR MODELS -->

    <section class="dashboard-section">

        <div class="section-header">

            <div>
                <h2>Popular Models</h2>

                <span class="section-subtitle">
                    Based on available market observations
                </span>
            </div>

        </div>


        <div class="dashboard-card chart-card">

            <div id="popularModelsChart"
                 class="dashboard-chart">
            </div>

        </div>

    </section>


    <!-- INDUSTRY INTELLIGENCE -->

    <section class="dashboard-section">

        <div class="section-header">

            <div>
                <h2>Industry Intelligence</h2>

                <span class="section-subtitle">
                    Pakistan production and global production indicators
                </span>
            </div>

        </div>


        <div class="dashboard-grid dashboard-grid-two">


            <div class="dashboard-card chart-card">

                <h3>PAMA Production & Sales</h3>

                <div id="pamaChart"
                     class="dashboard-chart">
                </div>

            </div>


            <div class="dashboard-card chart-card">

                <h3>OICA Global Production</h3>

                <div id="oicaChart"
                     class="dashboard-chart">
                </div>

            </div>

        </div>

    </section>


    <!-- DATA QUALITY -->

    <section class="dashboard-section">

        <div class="section-header">

            <div>
                <h2>Data Health</h2>

                <span class="section-subtitle">
                    Import and data-quality indicators
                </span>
            </div>

        </div>


        <div class="dashboard-grid">


            <div class="dashboard-card kpi-card">

                <div class="kpi-label">
                    Records Processed
                </div>

                <div class="kpi-value">
                    @Model.DataQuality.TotalRecordsProcessed.ToString("N0")
                </div>

            </div>


            <div class="dashboard-card kpi-card">

                <div class="kpi-label">
                    Rejection Rate
                </div>

                <div class="kpi-value">
                    @Model.DataQuality.RejectionRate.ToString("0.##")%
                </div>

            </div>


            <div class="dashboard-card kpi-card">

                <div class="kpi-label">
                    Duplicate Rate
                </div>

                <div class="kpi-value">
                    @Model.DataQuality.DuplicateRate.ToString("0.##")%
                </div>

            </div>


            <div class="dashboard-card kpi-card">

                <div class="kpi-label">
                    Total Imports
                </div>

                <div class="kpi-value">
                    @Model.DataQuality.TotalImports
                </div>

            </div>

        </div>

    </section>


    <!-- DATA FOR JAVASCRIPT -->

    <script type="application/json"
            id="adminDashboardData">
        @Html.Raw(JsonSerializer.Serialize(
            new
            {
                priceTrends = Model.PriceTrends,
                popularModels = Model.PopularModels,
                pamaYearlySummary = Model.PamaYearlySummary,
                oicaYearlySummary = Model.OicaYearlySummary
            },
            jsonOptions))
    </script>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="https://code.highcharts.com/highcharts.js"></script>

    <script src="https://code.highcharts.com/modules/exporting.js"></script>

    <script src="https://code.highcharts.com/modules/export-data.js"></script>

    <script src="https://code.highcharts.com/modules/accessibility.js"></script>

    <script src="~/js/admin-dashboard.js"
            asp-append-version="true"></script>

}