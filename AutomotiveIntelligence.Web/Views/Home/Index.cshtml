@{
    ViewData["Title"] = "Automotive Intelligence";
}

<div class="ai-home">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="ai-home-hero">

        <div class="ai-home-hero-content">

            <div class="ai-home-eyebrow">
                AUTOMOTIVE INTELLIGENCE
            </div>

            <h1>
                Know the Market.
                <span>Value with Confidence.</span>
            </h1>

            <p class="ai-home-hero-text">
                A data-driven automotive intelligence platform for
                understanding vehicle prices, exploring the used-car
                market and making informed valuation decisions.
            </p>

            <div class="ai-home-actions">

                <a asp-controller="Valuation"
                   asp-action="Index"
                   class="ai-btn ai-btn-primary">

                    <span class="ai-btn-icon">
                        $
                    </span>

                    Value My Car

                </a>


                <a asp-controller="MarketIntelligence"
                   asp-action="Index"
                   class="ai-btn ai-btn-secondary">

                    Explore Market Intelligence

                    <span class="ai-btn-arrow">
                        →
                    </span>

                </a>

            </div>


            <div class="ai-home-trust">

                <div class="ai-trust-item">

                    <span class="ai-trust-number">
                        9,911
                    </span>

                    <span class="ai-trust-label">
                        Market observations
                    </span>

                </div>


                <div class="ai-trust-divider"></div>


                <div class="ai-trust-item">

                    <span class="ai-trust-number">
                        5
                    </span>

                    <span class="ai-trust-label">
                        Vehicle makes
                    </span>

                </div>


                <div class="ai-trust-divider"></div>


                <div class="ai-trust-item">

                    <span class="ai-trust-number">
                        11
                    </span>

                    <span class="ai-trust-label">
                        Cities covered
                    </span>

                </div>

            </div>

        </div>


        <!-- =================================================
             HERO VISUAL
             ================================================= -->

        <div class="ai-home-hero-visual">

            <div class="ai-vehicle-card">

                <div class="ai-vehicle-card-top">

                    <span>
                        MARKET ESTIMATE
                    </span>

                    <span class="ai-live-indicator">
                        <i></i>
                        LIVE DATA
                    </span>

                </div>


                <div class="ai-car-visual">

                    <div class="ai-car-glow"></div>

                    <div class="ai-car-body">

                        <div class="ai-car-roof"></div>

                        <div class="ai-car-window ai-car-window-left"></div>

                        <div class="ai-car-window ai-car-window-right"></div>

                        <div class="ai-car-wheel ai-car-wheel-left"></div>

                        <div class="ai-car-wheel ai-car-wheel-right"></div>

                    </div>

                </div>


                <div class="ai-estimate-preview">

                    <div>

                        <span>
                            Estimated Market Value
                        </span>

                        <strong>
                            PKR 5.01M
                        </strong>

                    </div>

                    <div class="ai-confidence-preview">

                        <span>
                            Confidence
                        </span>

                        <strong>
                            80%
                        </strong>

                    </div>

                </div>


                <div class="ai-range-preview">

                    <span>
                        Market Range
                    </span>

                    <div class="ai-range-line">

                        <i></i>

                    </div>

                    <div class="ai-range-values">

                        <span>
                            PKR 4.50M
                        </span>

                        <span>
                            PKR 5.51M
                        </span>

                    </div>

                </div>

            </div>


            <div class="ai-floating-card ai-floating-card-top">

                <span class="ai-floating-icon">
                    ↑
                </span>

                <div>

                    <strong>
                        Market Data
                    </strong>

                    <span>
                        Price trends & insights
                    </span>

                </div>

            </div>


            <div class="ai-floating-card ai-floating-card-bottom">

                <span class="ai-floating-icon">
                    ✓
                </span>

                <div>

                    <strong>
                        Data Driven
                    </strong>

                    <span>
                        Multiple market signals
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         HOW IT WORKS
         ===================================================== -->

    <section class="ai-home-section ai-how-section">

        <div class="ai-section-heading">

            <span>
                HOW IT WORKS
            </span>

            <h2>
                From vehicle details to market intelligence.
            </h2>

            <p>
                Automotive Intelligence combines vehicle information
                with available market observations to produce a
                practical valuation and market view.
            </p>

        </div>


        <div class="ai-how-grid">

            <div class="ai-how-card">

                <div class="ai-how-number">
                    01
                </div>

                <div class="ai-how-icon">
                    🚗
                </div>

                <h3>
                    Describe the Vehicle
                </h3>

                <p>
                    Enter the make and model for a quick estimate,
                    or provide additional details such as year,
                    variant, mileage, city and condition.
                </p>

            </div>


            <div class="ai-how-card">

                <div class="ai-how-number">
                    02
                </div>

                <div class="ai-how-icon">
                    ◈
                </div>

                <h3>
                    Analyze the Market
                </h3>

                <p>
                    Available market observations are analyzed
                    across vehicle characteristics, location and
                    historical pricing information.
                </p>

            </div>


            <div class="ai-how-card">

                <div class="ai-how-number">
                    03
                </div>

                <div class="ai-how-icon">
                    ✓
                </div>

                <h3>
                    Understand the Value
                </h3>

                <p>
                    Receive an estimated market value, price range,
                    confidence level and supporting valuation factors.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PRODUCT FEATURES
         ===================================================== -->

    <section class="ai-home-section ai-features-section">

        <div class="ai-section-heading ai-section-heading-left">

            <span>
                PLATFORM CAPABILITIES
            </span>

            <h2>
                One platform for vehicle valuation
                and market intelligence.
            </h2>

        </div>


        <div class="ai-feature-grid">

            <!-- Valuation -->

            <a asp-controller="Valuation"
               asp-action="Index"
               class="ai-feature-card ai-feature-card-featured">

                <div class="ai-feature-top">

                    <span class="ai-feature-icon">
                        $
                    </span>

                    <span class="ai-feature-link">
                        Explore →
                    </span>

                </div>

                <h3>
                    Vehicle Valuation
                </h3>

                <p>
                    Estimate a vehicle's market value using available
                    observations and vehicle-specific factors.
                </p>

                <div class="ai-feature-points">

                    <span>
                        ✓ Quick estimates
                    </span>

                    <span>
                        ✓ Detailed valuation
                    </span>

                    <span>
                        ✓ Market range
                    </span>

                    <span>
                        ✓ Confidence score
                    </span>

                </div>

            </a>


            <!-- Market Intelligence -->

            <a asp-controller="MarketIntelligence"
               asp-action="Index"
               class="ai-feature-card">

                <div class="ai-feature-top">

                    <span class="ai-feature-icon">
                        ◈
                    </span>

                    <span class="ai-feature-link">
                        Explore →
                    </span>

                </div>

                <h3>
                    Market Intelligence
                </h3>

                <p>
                    Explore observed prices across makes, models,
                    cities and model years.
                </p>

                <div class="ai-feature-points">

                    <span>
                        ✓ Price trends
                    </span>

                    <span>
                        ✓ Market distribution
                    </span>

                    <span>
                        ✓ City analysis
                    </span>

                    <span>
                        ✓ Model analysis
                    </span>

                </div>

            </a>


            <!-- Data Intelligence -->

            <div class="ai-feature-card">

                <div class="ai-feature-top">

                    <span class="ai-feature-icon">
                        ◇
                    </span>

                    <span class="ai-feature-status">
                        FOUNDATION
                    </span>

                </div>

                <h3>
                    Data Intelligence
                </h3>

                <p>
                    A structured data layer designed to bring together
                    market observations and automotive data sources.
                </p>

                <div class="ai-feature-points">

                    <span>
                        ✓ Data normalization
                    </span>

                    <span>
                        ✓ Source tracking
                    </span>

                    <span>
                        ✓ Data quality
                    </span>

                    <span>
                        ✓ Market history
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MARKET SNAPSHOT
         ===================================================== -->

    <section class="ai-market-snapshot">

        <div class="ai-market-snapshot-content">

            <div>

                <span class="ai-section-eyebrow">
                    MARKET SNAPSHOT
                </span>

                <h2>
                    See the market beyond a single car.
                </h2>

                <p>
                    Explore how observed prices vary across makes,
                    models, cities and model years. The market
                    intelligence layer provides the foundation for
                    deeper automotive analysis.
                </p>

                <a asp-controller="MarketIntelligence"
                   asp-action="Index"
                   class="ai-text-link">

                    Explore Market Intelligence

                    <span>
                        →
                    </span>

                </a>

            </div>


            <div class="ai-snapshot-grid">

                <div class="ai-snapshot-card">

                    <span>
                        OBSERVATIONS
                    </span>

                    <strong>
                        9,911
                    </strong>

                    <small>
                        Market records
                    </small>

                </div>


                <div class="ai-snapshot-card">

                    <span>
                        AVERAGE
                    </span>

                    <strong>
                        PKR 3.47M
                    </strong>

                    <small>
                        Observed market price
                    </small>

                </div>


                <div class="ai-snapshot-card">

                    <span>
                        COVERAGE
                    </span>

                    <strong>
                        11
                    </strong>

                    <small>
                        Cities represented
                    </small>

                </div>


                <div class="ai-snapshot-card">

                    <span>
                        YEARS
                    </span>

                    <strong>
                        41
                    </strong>

                    <small>
                        Model years represented
                    </small>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FUTURE INTELLIGENCE
         ===================================================== -->

    <section class="ai-home-section ai-future-section">

        <div class="ai-future-content">

            <div>

                <span class="ai-section-eyebrow">
                    BUILT TO EVOLVE
                </span>

                <h2>
                    From rule-based valuation
                    to automotive intelligence.
                </h2>

                <p>
                    The platform is designed as an extensible foundation.
                    Today's market-data valuation can evolve toward
                    machine-learning models, predictive pricing,
                    depreciation analysis and richer automotive
                    intelligence.
                </p>

            </div>


            <div class="ai-roadmap">

                <div class="ai-roadmap-item ai-roadmap-active">

                    <div class="ai-roadmap-dot"></div>

                    <div>

                        <strong>
                            Market Data
                        </strong>

                        <span>
                            Structured observations
                            and source tracking
                        </span>

                    </div>

                </div>


                <div class="ai-roadmap-line"></div>


                <div class="ai-roadmap-item ai-roadmap-active">

                    <div class="ai-roadmap-dot"></div>

                    <div>

                        <strong>
                            Rule-Based Valuation
                        </strong>

                        <span>
                            Current valuation engine
                        </span>

                    </div>

                </div>


                <div class="ai-roadmap-line"></div>


                <div class="ai-roadmap-item">

                    <div class="ai-roadmap-dot"></div>

                    <div>

                        <strong>
                            Machine Learning
                        </strong>

                        <span>
                            Future predictive valuation
                        </span>

                    </div>

                </div>


                <div class="ai-roadmap-line"></div>


                <div class="ai-roadmap-item">

                    <div class="ai-roadmap-dot"></div>

                    <div>

                        <strong>
                            Automotive AI
                        </strong>

                        <span>
                            Intelligent automotive assistant
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CTA
         ===================================================== -->

    <section class="ai-home-cta">

        <div>

            <span>
                READY TO EXPLORE?
            </span>

            <h2>
                Start with a vehicle valuation.
            </h2>

            <p>
                Enter a few vehicle details and see what the
                available market data says.
            </p>

        </div>


        <a asp-controller="Valuation"
           asp-action="Index"
           class="ai-btn ai-btn-light">

            Start Valuation

            <span>
                →
            </span>

        </a>

    </section>

</div>